@echo off
rem =====================================================================
rem ncu_build.bat - assemble + link a program generated by NcuFuck
rem
rem Usage: ncu_build <path without .asm> [keep]
rem   ncu_build bin\hello        -> bin\hello.exe
rem   ncu_build bin\hello keep   -> also keep bin\hello.obj / bin\hello.log
rem
rem Exit code: 0 = OK, 1 = ml or link failed, 2 = bad usage
rem The ml / link messages go to <name>.log and are only printed when
rem something goes wrong.
rem =====================================================================
setlocal

if "%~1"=="" (
    echo Usage: ncu_build ^<path without .asm^> [keep]
    exit /b 2
)
if not exist "%~1.asm" (
    echo [ncu_build] File not found: %~1.asm
    exit /b 2
)

rem Set up the 32-bit tools only if ml is not already on PATH (vcvars is slow)
where ml >nul 2>&1
if errorlevel 1 call "C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars32.bat" >nul 2>&1

rem Work inside the folder of the .asm so .obj / .exe land next to it
rem (%~nx1 instead of %~n1, so a name like "hello.v2" keeps its ".v2")
pushd "%~dp1"
set "NAME=%~nx1"

ml /nologo /c /coff /I C:\Irvine "%NAME%.asm" > "%NAME%.log" 2>&1
if errorlevel 1 goto fail
link /nologo /SUBSYSTEM:CONSOLE /ENTRY:start /LIBPATH:C:\Irvine "%NAME%.obj" Irvine32.lib kernel32.lib user32.lib >> "%NAME%.log" 2>&1
if errorlevel 1 goto fail

if /i not "%~2"=="keep" del "%NAME%.obj" "%NAME%.log" 2>nul
popd
exit /b 0

:fail
echo [ncu_build] ml / link failed:
type "%NAME%.log"
if /i not "%~2"=="keep" del "%NAME%.obj" "%NAME%.log" 2>nul
popd
exit /b 1
